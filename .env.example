# Google Gemini (optional). The app uses curated deterministic fallbacks when
# no key is set, so the full plan still works offline.
GEMINI_API_KEY=
# Optional model override. Use a model available to your Gemini API key.
GEMINI_MODEL=gemini-3.5-flash
# Set to "true" ONLY if the app is self-hosted behind a trusted proxy
# (nginx, HAProxy, Cloudflare, …) that appends x-forwarded-for / x-real-ip
# with the real client IP. On Vercel the app sets VERCEL=1 itself and the
# limiter already trusts the edge-rewritten forwarded headers, so this is
# unnecessary there.
#
# When neither TRUST_PROXY=true nor VERCEL=1 is set (e.g. plain `next start`
# with no proxy), the limiter ignores forwarded headers and all requests
# share a single bucket per route, so the 12 req/min limit applies per
# instance rather than per client IP.
TRUST_PROXY=
